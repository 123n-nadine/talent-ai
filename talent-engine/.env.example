# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
TZ=UTC

# Host ports (18000-18099 only)
API_PORT=18000
DB_HOST_PORT=18030
REDIS_HOST_PORT=18031

# Compose database credentials (dev only)
POSTGRES_USER=talentai
POSTGRES_PASSWORD=talentai
POSTGRES_DB=talentai

# Connection strings as seen from the host (compose overrides them for containers)
DATABASE_URL=postgresql+psycopg://talentai:talentai@127.0.0.1:18030/talentai
REDIS_URL=redis://127.0.0.1:18031/0
QUEUE_MODE=rq            # rq | inline

# AI provider defaults for a NEW tenant (the engine owns the effective values, see /v1/settings)
AI_PROVIDER=fake         # fake (phase 1) | local (phase 3) | cloud (disabled until a key exists)
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=qwen3-8b-awq
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
VLLM_GPU_MEMORY_UTILIZATION=0.40
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=
OCR_PROVIDER=none        # none (phase 1) | paddle_cpu | paddle_vl | cloud
OCR_MIN_CONFIDENCE=0.80
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
FILE_STORE=./data/files
RETENTION_DAYS_DEFAULT=365
MAX_ATTEMPTS=3

# Default tenant (dev). The adapter uses this key as "Authorization: Bearer <key>".
TENANT_NAME=dev
TENANT_API_KEY=dev-talentai-key-change-me
ALLOWED_FACTS=nationality,height_cm,weight_kg,age

# Where results are pushed (HMAC-signed). Empty = no callback.
# For the local test receiver (make receiver) use http://host.docker.internal:18060/callback
CALLBACK_URL=
CALLBACK_SECRET=dev-callback-secret-change-me
