# Copy with `make env` (generates the secrets below). Never commit .env.
APP_ENV=dev
API_DOCS_ENABLED=true    # /docs and /openapi.json; unset = on unless APP_ENV=production
LOG_LEVEL=INFO
TZ=UTC

# Host ports (18000-18099 only). DB and Redis bind to 127.0.0.1 only; the API binds to
# 127.0.0.1 and to the Tailscale address below, never to 0.0.0.0.
API_PORT=18000
API_BIND_TAILSCALE=100.85.37.127
DB_HOST_PORT=18030
REDIS_HOST_PORT=18031

# Secrets: `make env` fills these with random values (python -c "import secrets; print(secrets.token_urlsafe(48))")
POSTGRES_USER=talentai
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=talentai
REDIS_PASSWORD=GENERATE_ME
TENANT_API_KEY=GENERATE_ME
CALLBACK_SECRET=GENERATE_ME

# Connection strings as seen from the host (compose overrides them for containers)
DATABASE_URL=postgresql+psycopg://talentai:GENERATE_ME@127.0.0.1:18030/talentai
REDIS_URL=redis://:GENERATE_ME@127.0.0.1:18031/0
QUEUE_MODE=rq            # rq | inline

# AI provider defaults for a NEW tenant (the engine owns the effective values, see /v1/settings)
AI_PROVIDER=local        # fake (tests) | local (vLLM, phase 3) | cloud (disabled until CLOUD_LLM_API_KEY is set)
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=qwen3-8b-awq   # served model name in vLLM
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_IMAGE_TAG=v0.31.0
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_MODEL_LEN=8192   # = VLLM_MAX_MODEL_LEN; the answer budget is what the prompt leaves of it
VLLM_GPU_MEMORY_UTILIZATION=0.40   # agreed cap on the shared GPU (~9.8 GB)
# Cloud provider: any OpenAI-compatible endpoint. Only the setting switch is needed once a key exists.
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=
OCR_PROVIDER=paddle_cpu  # none | fake (tests) | paddle_cpu (phase 2, CPU) | paddle_vl (GPU, phase 3) | cloud
OCR_THREADS=8            # CPU threads for PaddleOCR (shared server: keep it modest)
MAX_UPLOAD_MB=10
OCR_MIN_CONFIDENCE=0.80
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_PROVIDER=local   # none | fake (tests) | local (embed service, CPU) | cloud (needs CLOUD_EMBEDDING_API_KEY)
EMBEDDING_BASE_URL=http://embed:8001/v1
FILE_STORE=./data/files
RETENTION_DAYS_DEFAULT=365
MAX_ATTEMPTS=3

# Default tenant (dev). The adapter sends "Authorization: Bearer <TENANT_API_KEY>".
# Changing TENANT_API_KEY and restarting the api rotates the key (the old key stops working).
TENANT_NAME=dev
ALLOWED_FACTS=nationality,height_cm,weight_kg,age

# Talent Console login (make env fills the password). The console shares the API port (127.0.0.1 + Tailscale only).
CONSOLE_USER=nadine
CONSOLE_PASSWORD=GENERATE_ME
CONSOLE_SESSION_SECRET=GENERATE_ME
CONSOLE_ID_TOKEN_SECRET=GENERATE_ME

# Where results are pushed (HMAC-signed). Empty = no callback. Can also be set at runtime via PUT /v1/settings.
# For the local test receiver (make receiver) use http://host.docker.internal:18060/callback
CALLBACK_URL=
